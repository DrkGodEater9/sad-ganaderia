# Copia este archivo a ".env" (en esta misma carpeta) y completa tus valores.

# Proyecto de Google Cloud para Earth Engine (el mismo que usas con
# earth-engine/extraer_indices.py). Obligatorio para POST /api/predecir.
EE_PROJECT=

# Ruta al GeoJSON de potreros exportado por SAD.
# Por defecto se busca "potreros.geojson" en la raiz del repo.
GEOJSON_PATH=

# Nombre de la finca que se muestra en la app (vista "Mis potreros").
FINCA_NOMBRE=Mi finca

# Origenes permitidos para CORS, separados por coma (por ejemplo:
# https://mi-potrero-mapper.netlify.app). "*" permite cualquier origen,
# util en desarrollo local.
CORS_ORIGINS=*

# Ruta a un archivo de clima diario en formato NASA POWER (columnas YEAR,
# DOY, T2M, PRECTOTCORR; descargable gratis en https://power.larc.nasa.gov/data-access-viewer/
# para la ubicacion de tu finca). Opcional: sin esto, el modelo entrena
# solo con los indices de satelite, sin variables de clima.
CLIMA_PATH=

# Umbrales del semaforo, en kg de materia seca por hectarea (kg MS/ha).
# Por debajo de UMBRAL_ROJO -> rojo. Entre UMBRAL_ROJO y UMBRAL_AMBAR ->
# ambar. Por encima de UMBRAL_AMBAR -> verde. Ajustalos con el criterio
# del productor de tu finca.
UMBRAL_ROJO=300
UMBRAL_AMBAR=500

# Busqueda de escena Sentinel-2 (earth-engine/extraer_indices.py): dias
# antes/despues de hoy y porcentaje maximo de nubes aceptado. Subelos si
# "Actualizar recomendaciones" falla por no encontrar ninguna escena
# utilizable (comun en epoca de lluvias).
EE_VENTANA_DIAS=15
EE_UMBRAL_NUBES=60

# Variables de entrada del modelo (lista separada por comas). Vacio = las 12
# por defecto (10 indices de satelite + 2 de clima). Con pocas mediciones de
# aforo conviene reducirlas: con menos muestras que variables el modelo
# sobreajusta y el R2 se vuelve negativo.
# Ejemplo: MODELO_VARIABLES=NDVI_mean,NDVI_stdDev,precip_30d_mm
MODELO_VARIABLES=
